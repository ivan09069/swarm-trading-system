# SWARM CONFIG
GROQ_API_KEY=your_groq_key_here
BASE_RPC=https://mainnet.base.org
ETH_RPC=https://eth.llamarpc.com
POLYGON_RPC=https://polygon-rpc.com
ARB_RPC=https://arb1.arbitrum.io/rpc

# Optional: Destination wallet for sweeps
SWEEP_DESTINATION=0xYourSafeWalletHere

# --- Wallet / seed / target configuration ---
# Option A: point to JSON files (gitignored, never committed)
CONTROLLED_WALLETS_FILE=wallets.json
SEEDS_FILE=seeds.json
TARGETS_FILE=targets.json
ADDRESSES_FILE=addresses.json

# Option B: inline JSON arrays (useful for CI/CD secrets)
# CONTROLLED_WALLETS_JSON=[{"address":"0x...","privkey":"...","name":"MyWallet"}]
# KEYMATCHER_SEEDS_JSON=[{"name":"Seed1","phrase":"word1 word2 ..."}]
# HIGH_VALUE_TARGETS_JSON=["0x...","0x..."]
# QUICK_CHECK_ADDRESSES=[{"address":"0x...","label":"MyLabel","key":"hex_or_UNKNOWN"}]

# Option C: indexed env vars for wallets (alternative to JSON file/env-var)
# WALLET_0_ADDRESS=0x...
# WALLET_0_PRIVKEY=...
# WALLET_0_NAME=MyWallet

# Option C: indexed env vars for seeds
# SEED_0_NAME=Seed1
# SEED_0_PHRASE=word1 word2 word3 ...

# Test seed (used only by test_keymatcher.py)
# TEST_SEED_PHRASE=word1 word2 ...
